# Copiez ce fichier vers .env et renseignez vos valeurs.

# Base de données PostgreSQL (Neon / Vercel Postgres — offre gratuite).
# Exemple Neon : postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Google Drive (optionnel)
GOOGLE_SERVICE_ACCOUNT_JSON=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
DRIVE_ROOT_FOLDER_ID=""

# Notifications sortantes (optionnel)
NOTIFY_WEBHOOK_URL=""
